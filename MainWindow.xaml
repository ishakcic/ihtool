<Window x:Class="SistemYonetici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Yöneticisi" Width="1200" Height="760" MinWidth="960" MinHeight="560"
        Background="#F2F4F8" Foreground="#0A0A0A" FontSize="13"
        FontFamily="Segoe UI Variable, Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#1E5EFF"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#E8EFFF"/>
    <SolidColorBrush x:Key="Green" Color="#34C759"/>
    <SolidColorBrush x:Key="Orange" Color="#FF9500"/>
    <SolidColorBrush x:Key="Red" Color="#FF3B30"/>
    <SolidColorBrush x:Key="Ink2" Color="#4A4D5A"/>
    <SolidColorBrush x:Key="Ink3" Color="#8A8D9A"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#E8EAF0"/>

    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryPill" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="DangerPill" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="#FFEAE9"/>
      <Setter Property="Foreground" Value="{StaticResource Red}"/>
    </Style>
    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="14" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F7F8FC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- SIDEBAR -->
    <DockPanel Background="#F2F4F8">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,16">
        <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource Blue}">
          <TextBlock Text="ih" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Sistem Yöneticisi" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Width="140"/>
      </StackPanel>

      <Border DockPanel.Dock="Bottom" Margin="12,0,12,16" Background="White" CornerRadius="16" Padding="12">
        <StackPanel>
          <TextBlock Text="YETKİ MODU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Ink3}" Margin="0,0,0,8"/>
          <ToggleButton x:Name="ChkAdv" Checked="Adv_Changed" Unchecked="Adv_Changed" Cursor="Hand">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Bd" CornerRadius="12" Padding="0,8" Background="#EDEFF5">
                  <TextBlock x:Name="Tb" Text="NORMAL" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Ink2}"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Red}"/>
                    <Setter TargetName="Tb" Property="Text" Value="NSUDO — GELİŞMİŞ"/>
                    <Setter TargetName="Tb" Property="Foreground" Value="White"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="NavPanel"/>
      </ScrollViewer>
    </DockPanel>

    <!-- MAIN -->
    <Grid Grid.Column="1" Margin="22,20,22,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <TextBlock x:Name="TitleTxt" FontSize="26" FontWeight="Bold"/>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
        <Border Background="White" CornerRadius="18" Padding="14,0" Width="240" Height="40">
          <TextBox x:Name="Filter" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                   TextChanged="Filter_Changed" ToolTip="Ara"/>
        </Border>
        <Button x:Name="BtnA" Style="{StaticResource Pill}" Margin="12,0,8,0" Click="BtnA_Click"/>
        <Button x:Name="BtnB" Style="{StaticResource Pill}" Click="BtnB_Click"/>
        <Button x:Name="BtnC" Style="{StaticResource DangerPill}" Click="BtnC_Click"/>
        <Button x:Name="BtnUp" Content="↑ Yukarı" Style="{StaticResource Pill}" Click="BtnUp_Click"/>
        <Button Content="Yenile" Style="{StaticResource Pill}" Click="Refresh_Click"/>
        <Button Content="Geri yükleme noktası" Style="{StaticResource Pill}" Click="Restore_Click"/>
      </StackPanel>

      <Border Grid.Row="2" Background="White" CornerRadius="24">
        <ListBox x:Name="Grid" Background="Transparent" BorderThickness="0" Padding="6"
                 SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="Grid_Dbl">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="13" VerticalAlignment="Top">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource Blue}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Risk}" Value="w"><Setter Property="Background" Value="{StaticResource Orange}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Risk}" Value="r"><Setter Property="Background" Value="{StaticResource Red}"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="36"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                    <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#E5F8E9"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Risk}" Value="w"><Setter Property="Background" Value="#FFF3E0"/></DataTrigger>
                            <DataTrigger Binding="{Binding Risk}" Value="r"><Setter Property="Background" Value="#FFEAE9"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding RiskText}" FontSize="10" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#34C759"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Risk}" Value="w"><Setter Property="Foreground" Value="#FF9500"/></DataTrigger>
                              <DataTrigger Binding="{Binding Risk}" Value="r"><Setter Property="Foreground" Value="#FF3B30"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Desc}" Foreground="{StaticResource Ink3}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="4"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="16" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueSoft}"/></Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F7F8FC"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>

      <TextBlock x:Name="StatusTxt" Grid.Row="3" Foreground="{StaticResource Ink3}" Margin="4,12,0,0" FontWeight="SemiBold"/>
    </Grid>
  </Grid>
</Window>
