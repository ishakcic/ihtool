<Window x:Class="SistemYonetici.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Yöneticisi" Width="1200" Height="740" MinWidth="900" MinHeight="500"
        Background="#12161F" Foreground="#E6EAF2" FontSize="13"
        FontFamily="Segoe UI Variable, Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="Background" Value="#252C3D"/><Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="BorderBrush" Value="#3A4560"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Background="#0E1119">
      <TextBlock DockPanel.Dock="Top" Text="⚡ Sistem Yöneticisi" FontSize="17" FontWeight="Bold" Margin="16,16,16,12"/>
      <CheckBox x:Name="ChkAdv" DockPanel.Dock="Bottom" Margin="16" Foreground="#FFB4A8"
                Content="Gelişmiş mod (NSudo)" Checked="Adv_Changed" Unchecked="Adv_Changed"/>
      <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Foreground="#C9D3DF"
               Padding="6" SelectionChanged="Nav_Changed"/>
    </DockPanel>
    <Grid Grid.Column="1" Margin="18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="TitleTxt" FontSize="22" FontWeight="SemiBold"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
        <TextBox x:Name="Filter" Width="220" Margin="0,0,10,0" Padding="6" Background="#1B2130" Foreground="#E6EAF2"
                 BorderBrush="#3A4560" TextChanged="Filter_Changed" ToolTip="Ara"/>
        <Button x:Name="BtnA" Click="BtnA_Click"/>
        <Button x:Name="BtnB" Click="BtnB_Click"/>
        <Button x:Name="BtnC" Click="BtnC_Click" Foreground="#FF8C87"/>
        <Button x:Name="BtnUp" Content="↑ Yukarı" Click="BtnUp_Click"/>
        <Button Content="Yenile" Click="Refresh_Click"/>
        <Button Content="Geri yükleme noktası" Click="Restore_Click"/>
      </StackPanel>
      <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                Background="#151A26" RowBackground="#151A26" AlternatingRowBackground="#1B2130"
                Foreground="#E6EAF2" BorderBrush="#252C3D" HorizontalGridLinesBrush="#252C3D"
                MouseDoubleClick="Grid_Dbl" RowHeaderWidth="0">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0E1119"/><Setter Property="Foreground" Value="#8F9AB3"/>
            <Setter Property="Padding" Value="8,6"/>
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="280"/>
          <DataGridTemplateColumn Header="Risk" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding RiskText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#4ADE9D"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Risk}" Value="w"><Setter Property="Foreground" Value="#FBBF4A"/></DataTrigger>
                        <DataTrigger Binding="{Binding Risk}" Value="r"><Setter Property="Foreground" Value="#FF8C87"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="110"/>
          <DataGridTemplateColumn Header="Ne işe yarar" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Desc}" TextWrapping="Wrap" Margin="6,4"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="StatusTxt" Grid.Row="3" Foreground="#8F9AB3" Margin="0,10,0,0"/>
    </Grid>
  </Grid>
</Window>
